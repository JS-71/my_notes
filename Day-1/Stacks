class Stack:
    def __init__(a):
        a.stack = []
    def push(a, data):
        a.stack.append(data)
    def pop(a):
        if not a.is_empty():
            return a.stack.pop()
        return "Stack is empty"
    def peek(a):
        if not a.is_empty():
            return a.stack[-1]
        return "Stack is empty"
    def is_empty(a):
        return len(a.stack) == 0
    def display(a):
        if not a.is_empty():
            print(a.stack[::-1])
        else:
            print ("Stack is empty")
a = Stack()
# print(a.push(10))
a.push(10)
a.push(20)
a.push(30)
a.display()

output:
[30, 20, 10, 10]

